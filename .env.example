# Spectre environment variables
# Copy this file to .env and fill in your values.

# --- Server ---

# REQUIRED. Password for the web UI login.
#
# The server refuses to start without this: anyone who has it can open a root
# shell on every enrolled machine. Generate a real one, do not invent one:
#
#     openssl rand -base64 24
#
ADMIN_PASSWORD=

# Local development only. Set to 1 to disable authentication entirely.
# Ignored (and fatal) when NODE_ENV=production. Never set this on a real server.
# SPECTRE_DEV_NO_AUTH=1

# HTTP server port.
PORT=8080

# Directory for the persistent device store (device key hashes, auth keys).
DATA_DIR=./data

# Allowed CORS origins (comma-separated), e.g. https://spectre.example.com
#
# Empty by default, which means no cross-origin access at all. You only need
# this if the web UI is served from a different origin than the API; the
# supplied Compose setup proxies the API onto the UI's origin, so it does not.
CORS_ORIGIN=

# Set to 1 only when a trusted reverse proxy sets X-Forwarded-For. When unset,
# rate limiting uses the socket address, which a client cannot forge.
# TRUST_PROXY=1

# Set to 1 to log a summary of terminal output for debugging. Off by default
# because terminal output contains whatever the operator typed.
# SPECTRE_DEBUG_TERMINAL=1

# --- Web UI ---

# URL of the control server API, used by the web UI container at runtime.
#
# Leave empty (the default) when the UI proxies the API on its own origin, as
# the supplied Compose setup does. Set it only if the API lives on a different
# origin, and add that origin to CORS_ORIGIN above.
SPECTRE_SERVER_HOST=

# Where the web UI container's nginx proxy forwards API requests.
SPECTRE_SERVER_UPSTREAM=server:8080
