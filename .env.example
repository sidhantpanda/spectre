# Spectre environment variables
# Copy this file to .env and fill in your values. The server loads the nearest
# .env automatically (searching up from its working directory), so a .env at the
# repo root is picked up whether you run from the root or from server/. Anything
# already set in your shell or by the dev scripts wins over the file.

# --- Server ---

# REQUIRED. Password for the web UI login.
#
# The server refuses to start without this: anyone who has it can open a root
# shell on every enrolled machine. Generate a real one, do not invent one:
#
#     openssl rand -base64 24
#
ADMIN_PASSWORD=

# Local development convenience. Set to 1 to allow the server to start WITHOUT
# a password (authentication off). It does NOT override a password: if
# ADMIN_PASSWORD is set, authentication stays on and this is ignored. Fatal when
# NODE_ENV=production. Never set this on a real server.
# SPECTRE_DEV_NO_AUTH=1

# The address agents should dial, shown in the UI's enrollment command, e.g.
# wss://spectre.example.com. Set this when agents must always dial a fixed
# public address. When unset and TRUST_PROXY=1, the UI advertises whatever
# origin the browser used to reach the proxy, which is correct for the supplied
# Compose setup; without a proxy it falls back to the detected LAN address.
# SPECTRE_PUBLIC_HOST=wss://spectre.example.com

# HTTP server port. Every route and WebSocket is served under /api, which is
# how the reverse proxy tells API traffic apart from the static web UI.
PORT=8080

# Directory for the persistent device store (device key hashes, auth keys).
DATA_DIR=./data

# Allowed CORS origins (comma-separated), e.g. https://spectre.example.com
#
# Empty by default, which means no cross-origin access at all. You only need
# this if the web UI is served from a different origin than the API; the
# supplied Compose setup serves both from the proxy's origin, so it does not.
CORS_ORIGIN=

# Set to 1 only when a trusted reverse proxy sets X-Forwarded-For and
# X-Forwarded-Proto. When unset, rate limiting uses the socket address (which a
# client cannot forge) and the agent address is not derived from headers.
# The supplied proxy container sets both.
# TRUST_PROXY=1

# Set to 1 to log a summary of terminal output for debugging. Off by default
# because terminal output contains whatever the operator typed.
# SPECTRE_DEBUG_TERMINAL=1

# --- Web UI ---

# Origin of the control server, used by the web UI container at runtime. The
# client appends /api to it.
#
# Leave empty (the default) when the proxy serves the UI and the API on one
# origin, as the supplied Compose setup does. Set it only if the API lives on a
# different origin, and add that origin to CORS_ORIGIN above.
SPECTRE_SERVER_HOST=

# --- Proxy ---

# Where the proxy container forwards each kind of request. Defaults match the
# service names in compose.yaml.
SPECTRE_SERVER_UPSTREAM=server:8080
SPECTRE_WEB_UI_UPSTREAM=web-ui:80

# Host port the proxy publishes: the only port a Spectre deployment exposes.
SPECTRE_PORT=3000
