# Spectre environment variables
# Copy this file to .env and fill in your values.

# --- Server ---

# Password for the web UI login. Leave empty to disable authentication.
ADMIN_PASSWORD=

# Shared token for legacy agent auth (used when agents connect without enrollment).
AGENT_AUTH_TOKEN=changeme

# HTTP server port.
PORT=8080

# Directory for persistent device store (enrollment tokens, device keys).
DATA_DIR=./data

# Allowed CORS origins (comma-separated). Use * for development.
CORS_ORIGIN=*

# --- Web UI ---

# URL of the control server API. Used by the web UI container at runtime.
# For Docker Compose, this is typically http://localhost:8080.
# Leave empty if the web UI is served from the same origin as the server.
SPECTRE_SERVER_HOST=http://localhost:8080
