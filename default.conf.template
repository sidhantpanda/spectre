# The single entrypoint for a Spectre deployment.
#
# Splits traffic on the path alone: /api/* is the control server (REST and all
# WebSockets, including the agent's), everything else is the static web UI.
# Both upstreams stay unpublished on the internal Docker network, so this is
# the one port to expose and the one place to terminate TLS.
#
# Mounted into the stock nginx image at /etc/nginx/templates/, whose entrypoint
# runs envsubst over it and writes /etc/nginx/conf.d/default.conf at start.
# NGINX_ENVSUBST_FILTER restricts substitution to SPECTRE_*, so nginx's own
# runtime variables below ($host, $http_upgrade, ...) are left alone.

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

# Preserve the scheme from an outer TLS-terminating proxy when there is one;
# otherwise report the scheme this server saw. The server uses this to tell
# agents whether to dial ws:// or wss://.
map $http_x_forwarded_proto $forwarded_proto {
  default $http_x_forwarded_proto;
  ''      $scheme;
}

server {
  listen 80;
  server_name _;

  proxy_http_version 1.1;

  # NOTE: proxy_set_header does not merge across levels — a location that sets
  # any header discards every inherited one. So each location below repeats the
  # full set rather than relying on a server-level block.

  location /api/ {
    proxy_pass http://${SPECTRE_SERVER_UPSTREAM};

    # $http_host, not $host: it keeps the port, and the server echoes this back
    # as the address agents should dial.
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;

    # Required for the terminal, agent-event and agent-register WebSockets.
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    # Terminal output is interactive and long-lived; don't buffer it or time
    # out an idle shell.
    proxy_buffering off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
  }

  location / {
    proxy_pass http://${SPECTRE_WEB_UI_UPSTREAM};

    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
  }
}
